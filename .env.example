# Copy this file to .env and fill in your own values. Never commit .env.

# Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Model OpenRouter tries first, as a slug in "provider/model-name" form.
# Pick one at https://openrouter.ai/models.
MODEL_PRIMARY=

# Optional: comma-separated fallback models, tried in order if the primary fails.
# Example shape: provider-a/model-x,provider-b/model-y
MODEL_FALLBACKS=

# Optional: model used by `python -m evals.run`. Defaults to MODEL_PRIMARY.
EVAL_MODEL=

# Optional: where llm-kit writes its usage log (default logs/usage.jsonl, git-ignored).
LLM_LOG_PATH=
